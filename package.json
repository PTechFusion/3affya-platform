{
  "name": "3affya-platform",
  "version": "0.1.0",
  "private": true,
  "description": "3affya: US-trained Arabic-speaking doctors for patients in the Gulf. Launch build by ProgrammX.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "screens": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm run i18n:check",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > lib/db/types.ts",
    "test:rls": "vitest run --config tests/rls/vitest.config.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@aws-sdk/client-bedrock-runtime": "3.1147.0",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
