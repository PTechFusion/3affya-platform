# Public site URL: links and the wordmark in emails, absolute links in pages. Set to the hosted URL on a deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prototype only: shows the "Viewing as" bar in the portals. Unset in production builds; the code is compiled out.
NEXT_PUBLIC_DEV_ROLE_SWITCH=1
# Prototype basic-auth gate, "user:password,user:password". Leave empty locally.
SITE_USERS=

# lane L1: Supabase (tasks 1.4, 1.5). These are the task 1.3 variables above, with the names the code reads.
# Local stack (npm run db:start): `npx supabase status -o env` prints the URL and both keys.
# lane L1: API URL, read by lib/db/client.ts and tests/rls. Local: http://127.0.0.1:55321
SUPABASE_URL=
# lane L1: anon key; queries run under RLS as the request's user (lib/db/client.ts, tests/rls).
SUPABASE_ANON_KEY=
# lane L1: server only, bypasses RLS; lib/db/client.ts gives it only to an admin with TOTP or a named system caller.
SUPABASE_SERVICE_ROLE_KEY=
# lane L1: Postgres URL for the seed and mapping scripts (scripts/*.py) only; the app never reads it.
# Local: postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_URL=
# lane L1: optional statement timeout for the seed scripts (default 15min; e.g. 30min, 900s, 0 for none).
# SEED_STATEMENT_TIMEOUT=15min

# lane L2: Stripe (task 1.8). Test-mode keys everywhere but production (ADR-6). Server only: none has NEXT_PUBLIC_.
# lane L2: secret API key (test mode until live is switched on), read by lib/stripe/client.ts only. Unused by the webhook.
STRIPE_SECRET_KEY=
# lane L2: webhook signing secret, read by app/api/stripe/webhook/route.ts. Local: `stripe listen --print-secret`.
STRIPE_WEBHOOK_SECRET=
# lane L2: publishable key for the M3 checkout pages (tasks 3.1 to 3.5); nothing reads it yet.
STRIPE_PUBLISHABLE_KEY=

# lane L3: AI client (task 1.9). Only lib/ai reads these (CLAUDE.md: never call a model SDK outside lib/ai).
# lane L3: anthropic | bedrock. ADR-3: anthropic (HIPAA-ready organisation in Dr Ayman's name); bedrock is the dated fallback (14 Nov).
AI_VENDOR=anthropic
# lane L3: the Claude model id; the key of its price in config/business.ts aiPricing (a model without a price is refused); /admin/ai-jobs shows it.
AI_MODEL=claude-opus-5-5
# lane L3: Anthropic API key (lib/ai/vendors/anthropic.ts). A normal key is fine for the synthetic spike; production uses the HIPAA organisation's key.
ANTHROPIC_API_KEY=
# lane L3: bedrock only (lib/ai/vendors/bedrock.ts). Credentials come from the AWS SDK's default chain (AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, or an instance role); add the Bedrock prices to config/business.ts aiPricing.bedrock before switching.
AWS_REGION=
# lane L3: bedrock only: the Bedrock model or inference-profile id of AI_MODEL, e.g. us.anthropic.claude-opus-5-5
AWS_BEDROCK_MODEL_ID=

# Transactional email (task 2.9). Resend API key for the verified mail.3affya.com domain; without it sendEmail returns
# { ok: false, error: "notConfigured" } and sends nothing. # lane L4
RESEND_API_KEY=
# Sender, e.g. "3affya <hello@mail.3affya.com>" (the default, config/business.ts emailSettings). # lane L4
EMAIL_FROM=
# Where replies go; defaults to the support inbox (business.supportEmail). # lane L4
EMAIL_REPLY_TO=
# The email preview at /[locale]/emails/[template] is dev-only: it answers 404 unless NEXT_PUBLIC_DEV_ROLE_SWITCH=1 above. # lane L4

# lane L5: test runner only, never read by the app (playwright.config.ts, tests/e2e/support/chromium.ts).
# lane L5: E2E_SKIP_BUILD=1 makes npm run test:e2e serve the existing build instead of building first (CI sets it).
# E2E_SKIP_BUILD=
# lane L5: port of the e2e server (default 3150).
# E2E_PORT=3150
# lane L5: a Chromium binary for Playwright when this Playwright version's build is not installed.
# CHROME_PATH=
