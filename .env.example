NEXT_PUBLIC_SITE_URL=http://localhost:3000
# AI_VENDOR=anthropic|bedrock, AI_MODEL=... (task 1.9)
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE (task 1.3)
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (task 1.8)
# RESEND_API_KEY (task 1.10)

# Prototype only: shows the "Viewing as" bar in the portals. Unset in production builds; the code is compiled out.
NEXT_PUBLIC_DEV_ROLE_SWITCH=1
# Prototype basic-auth gate, "user:password,user:password". Leave empty locally.
SITE_USERS=

# lane L1: Supabase (tasks 1.4, 1.5). These are the task 1.3 variables above, with the names the code reads.
# Local stack (npm run db:start): `npx supabase status -o env` prints the URL and both keys.
# lane L1: API URL, read by lib/db/client.ts and tests/rls. Local: http://127.0.0.1:55321
SUPABASE_URL=
# lane L1: anon key; queries run under RLS as the request's user (lib/db/client.ts, tests/rls).
SUPABASE_ANON_KEY=
# lane L1: server only, bypasses RLS; lib/db/client.ts gives it only to an admin with TOTP or a named system caller.
SUPABASE_SERVICE_ROLE_KEY=
# lane L1: Postgres URL for the seed and mapping scripts (scripts/*.py) only; the app never reads it.
# Local: postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_URL=
# lane L1: optional statement timeout for the seed scripts (default 15min; e.g. 30min, 900s, 0 for none).
# SEED_STATEMENT_TIMEOUT=15min

# lane L2: Stripe (task 1.8). Test-mode keys everywhere but production (ADR-6). Server only: none has NEXT_PUBLIC_.
# lane L2: secret API key (test mode until live is switched on), read by lib/stripe/client.ts only. Unused by the webhook.
STRIPE_SECRET_KEY=
# lane L2: webhook signing secret, read by app/api/stripe/webhook/route.ts. Local: `stripe listen --print-secret`.
STRIPE_WEBHOOK_SECRET=
# lane L2: publishable key for the M3 checkout pages (tasks 3.1 to 3.5); nothing reads it yet.
STRIPE_PUBLISHABLE_KEY=
